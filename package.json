{
  "name": "@nomideusz/svelte-geometrize",
  "version": "0.7.0",
  "description": "Geometric image placeholders for Svelte 5 — triangles resolve into the real photo as it loads. Build-time shape fitting, tiny runtime.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "svelte-geometrize": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fit": {
      "types": "./dist/fit/index.d.ts",
      "default": "./dist/fit/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package && node scripts/chmod-cli.js",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@types/node": ">=20",
    "sharp": ">=0.33.0",
    "svelte": "^5.0.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "geometrizejs": "^0.0.19"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0-next.3",
    "@sveltejs/adapter-vercel": "7.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.23",
    "@sveltejs/package": "3.0.0-next.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^25.9.4",
    "marked": "^17.0.6",
    "sharp": "^0.34.5",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "lqip",
    "placeholder",
    "geometrize",
    "primitive",
    "image",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nomideusz/svelte-geometrize"
  },
  "homepage": "https://svelte-geometrize.vercel.app/"
}
